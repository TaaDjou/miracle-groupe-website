NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/miracle_groupe

# Comma-separated list of origins allowed to call this API
CLIENT_URL=http://localhost:5173

# JWT auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Outgoing email (all optional). Leave unset in dev - a free Ethereal test inbox
# is auto-created, and every sent email logs a preview URL to the console.
# Set these to switch to a real provider (Gmail app password, Resend, SendGrid, etc.)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your_api_key
# EMAIL_FROM=Miracle Groupe <no-reply@yourdomain.com>
